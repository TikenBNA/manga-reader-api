# Caddy сам получает и продлевает сертификат Let's Encrypt.
# Замените tikenmanga.duckdns.org на свой адрес (DuckDNS даёт бесплатный поддомен).
tikenmanga.duckdns.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:3001 {
        transport http {
            read_timeout 120s
        }
    }
    header {
        Access-Control-Allow-Origin *
    }
    log {
        output file /var/log/caddy/manga.log
        level WARN
    }
}
