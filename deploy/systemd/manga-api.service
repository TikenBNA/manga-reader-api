[Unit]
Description=Manga reader API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=manga
WorkingDirectory=/opt/manga
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=MM_CACHE_DIR=/opt/manga/cache
Environment=MM_TAG_PAGES=3
Environment=MM_TAG_TIMEOUT=3000
Environment=MM_CATALOG_TTL=43200000
ExecStart=/usr/bin/node /opt/manga/server.js
Restart=always
RestartSec=3
# сервер лёгкий: не даём ядру убить его по памяти на микро-инстансе
MemoryMax=900M

[Install]
WantedBy=multi-user.target
